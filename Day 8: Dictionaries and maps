//Problem: Build a phone book using a map and print the corresponding phone number for each queried name, or "Not found" if the name doesn't exist.
//Topic: Map (Key-Value Pair Mapping)
//Language Used: C++11


#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include <map>
using namespace std;

int main() {
    int n;
    cin >> n;

    map<string, string> phoneBook;

    for (int i = 0; i < n; i++) {
        string name, number;
        cin >> name >> number;
        phoneBook[name] = number;
    }

    string query;
    while (cin >> query) {
        if (phoneBook.find(query) != phoneBook.end()) {
            cout << query << "=" << phoneBook[query] << endl;
        } else {
            cout << "Not found" << endl;
        }
    }

    return 0;
}

//Problem: Calculate the library fine based on the difference between the actual return date and the due date according to the given penalty rules.
//Topic: Conditional Statements / Date Comparison.
//Pattern: Medium

#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    int d1, m1, y1;
    int d2, m2, y2;

    cin >> d1 >> m1 >> y1;
    cin >> d2 >> m2 >> y2;

    if (y1 > y2) {
        cout << 10000;
    }
    else if (y1 == y2 && m1 > m2) {
        cout << 500 * (m1 - m2);
    }
    else if (y1 == y2 && m1 == m2 && d1 > d2) {
        cout << 15 * (d1 - d2);
    }
    else {
        cout << 0;
    }   
    return 0;
}
